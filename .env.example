# Server Port & Environment
PORT=3000
NODE_ENV="production"

# Frontend & Backend Base URLs
APP_URL="https://drawe-sigma.vercel.app"
API_URL="https://drawe.onrender.com"
TELEGRAM_MINI_APP_URL="https://drawe-sigma.vercel.app"

# Database & Authentication
# MONGODB_URI: MongoDB Atlas connection string with replica set support
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/adey_draw_db?retryWrites=true&w=majority"
JWT_SECRET="super-secret-jwt-signing-key-for-auth"

# Telegram Bot Integration (BotFather Credentials)
# TELEGRAM_BOT_TOKEN: HTTP API Token provided by @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# TELEGRAM_BOT_USERNAME: The Telegram bot username handle
TELEGRAM_BOT_USERNAME="DraweBot"

# TELEGRAM_WEBHOOK_SECRET: Secret token for validating incoming Telegram webhooks (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="generate-a-strong-random-secret-token"

# Optional Gemini API Key (if AI features are enabled)
GEMINI_API_KEY=""
